# Copy to the target's private configuration, not the repository. No secret values here.
AVITY_CRM_PROJECT=avity-crm
AVITY_CRM_ENV_FILE=/etc/avity-crm/avity-crm.env
AVITY_CRM_ADMIN_FILE=/etc/avity-crm/admin.json
AVITY_CRM_BACKUP_ROOT=/var/backups/avity-crm
AVITY_CRM_BACKUP_LOCK=/run/lock/avity-crm-backup.lock
AVITY_CRM_PUBLICATION_BACKUP=1
AVITY_CRM_PUBLICATION_ROOT=/
# Set to a verified public key file and its full fingerprint before scheduling.
AVITY_CRM_GPG_PUBLIC_KEY_FILE=/etc/avity-crm/backup-recipient.gpg
AVITY_CRM_GPG_RECIPIENT=
# Existing off-host filesystem mounted separately. Do not use the source backup disk.
AVITY_CRM_EXPORT_DESTINATION=
AVITY_CRM_EXPORT_MOUNT_SOURCE=
AVITY_CRM_EXPORT_MOUNT_FSTYPE=
AVITY_CRM_EXPORT_MOUNT_TARGET=
AVITY_CRM_BACKUP_KEEP_COUNT=14
AVITY_CRM_BACKUP_LOCAL_KEEP_COUNT=2
